# Auth
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Optional client-side origin override for Better Auth browser calls
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# DB
DATABASE_URL="your-database-url"

# Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_DRIVE_FOLDER_ID="1zjSIzFlh8dEHVdGDZoRKWkC7vROWPG1A"
# Domain-wide delegation: real Workspace account the service account impersonates when creating Drive files
GOOGLE_IMPERSONATED_USER_EMAIL="board@yourdomain.org"
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-project.iam.gserviceaccount.com"}'

# Resend
RESEND_API_KEY="your-resend-api-key"
EMAIL_SENDER_NAME="GEARS"
EMAIL_SENDER_ADDRESS="no-reply@gearsnl.org"

# Organization deletion confirmation
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('your-secret-key').digest('hex'))"
ORG_DELETE_KEY="replace-with-sha256-hex-hash"