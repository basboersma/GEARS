# Auth
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Optional client-side origin override for Better Auth browser calls
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# DB
DATABASE_URL="your-database-url"

# Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend
RESEND_API_KEY="your-resend-api-key"
EMAIL_SENDER_NAME="warrior"
EMAIL_SENDER_ADDRESS="no-reply@example.com"


# Rabobank
RABOBANK_OAUTH_BASE_URL="https://oauth.rabobank.nl/openapi/oauth2-premium"
RABOBANK_API_BASE_URL="https://api.rabobank.nl/openapi/payments"
RABOBANK_CLIENT_ID="your-rabobank-client-id"
RABOBANK_CLIENT_SECRET="your-rabobank-client-secret"
RABOBANK_REDIRECT_URI="https://your-app.example.com/api/rabobank/callback"
RABOBANK_MTLS_CERT="/secure/path/to/mTLS-cert.pem"
RABOBANK_MTLS_KEY="/secure/path/to/mTLS-key.pem"
RABOBANK_SIGNING_CERT="/secure/path/to/signing-cert.pem"
RABOBANK_SIGNING_KEY="/secure/path/to/signing-key.pem"